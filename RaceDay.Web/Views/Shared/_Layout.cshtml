<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-success d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-flag-fill"></i> RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-indicator"><i class="bi bi-list fs-4 text-white"></i></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Organiser"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Organiser" asp-action="Events">Manage Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Organiser" asp-action="CreateEvent">Create Race</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Participant" asp-action="Events">Upcoming Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Participant" asp-action="MyResults">My Results</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Participant" asp-action="Profile">Profile</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="badge bg-secondary py-2 px-3">
                                @(User.Identity.Name ?? "RaceDay User") (@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Participant"))
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Sign Out</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm px-3">Sign In</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-sm px-3">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3 bg-white text-center mt-auto">
        <div class="container">
            <small>&copy; 2026 RaceDay Platform - PROG6212 Portfolio of Evidence</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>