@{
    ViewData["Title"] = "Create New Race Event";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success px-3 py-2 text-uppercase fw-semibold mb-2">Organiser Portal</span>
            <h2 class="fw-bold text-dark mb-0">Create New Race Event</h2>
            <p class="text-muted">Fill in the event parameters and upload an official banner to Azure Blob Storage.</p>
        </div>
        <a asp-action="Events" class="btn btn-outline-secondary">&larr; Back to Events</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
        </div>
    }

    <div class="card border-0 shadow-sm p-4">
        <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label fw-bold">Event Name <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Pretoria City Marathon 2026" required />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Date & Start Time <span class="text-danger">*</span></label>
                    <input type="datetime-local" name="date" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Location / Venue <span class="text-danger">*</span></label>
                    <input type="text" name="location" class="form-control" placeholder="e.g. Hatfield Plaza, Pretoria" required />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Default Distance <span class="text-danger">*</span></label>
                    <input type="text" name="distance" class="form-control" placeholder="e.g. 10km, 21.1km, 42.2km" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Event Type <span class="text-danger">*</span></label>
                    <select name="eventType" class="form-select" required>
                        <option value="Road Running">Road Running</option>
                        <option value="Trail Run">Trail Run</option>
                        <option value="Ultra Marathon">Ultra Marathon</option>
                        <option value="Charity Fun Run">Charity Fun Run</option>
                        <option value="Cycling">Cycling</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Event Banner Image</label>
                <input type="file" name="bannerImage" class="form-control" accept="image/*" />
                <small class="text-muted">The file is sent to <code>RaceDay.Api</code> and stored securely in Azure Blob Storage.</small>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Description & Race Details</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Detail course rules, cut-off times, water stations, and registration instructions..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Events" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn btn-success fw-bold px-4 py-2">Publish Event 🏁</button>
            </div>

        </form>
    </div>
</div>