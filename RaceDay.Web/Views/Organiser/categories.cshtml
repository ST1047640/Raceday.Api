@{
    ViewData["Title"] = "Race Categories";
    var eventId = ViewBag.EventId;
    var eventName = ViewBag.EventName ?? $"Event #{eventId}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success px-3 py-2 text-uppercase fw-semibold mb-2">Race Setup</span>
            <h2 class="fw-bold text-dark mb-0">Categories for @eventName</h2>
            <p class="text-muted">Manage distance tiers, entry fees, and qualification cutoffs.</p>
        </div>
        <a asp-action="Events" class="btn btn-outline-secondary">&larr; Back to Events</a>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3 text-dark">Add New Category</h5>
                <form asp-action="AddCategory" method="post">
                    <input type="hidden" name="eventId" value="@eventId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name</label>
                        <input type="text" name="categoryName" class="form-control" placeholder="e.g. 10km Road Race" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Distance</label>
                        <input type="text" name="distance" class="form-control" placeholder="e.g. 10km" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Entry Fee (ZAR)</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input type="number" step="0.01" name="entryFee" class="form-control" placeholder="150.00" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success fw-bold w-100 py-2 mt-2">
                        + Save Category
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3 text-dark">Configured Categories</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>Distance</th>
                                <th>Fee</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="categoryTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">No categories configured yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>