@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Organiser Dashboard</h1>
            <p class="text-muted mb-0">Manage your races, categories, results, and participants.</p>
        </div>
        <a asp-action="Events" class="btn btn-primary px-4 py-2 fw-semibold">
            Manage Races & Events 🏁
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Active Races</h6>
                    <h2 class="fw-bold mb-0 text-primary">@ViewBag.TotalEvents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Registered Runners</h6>
                    <h2 class="fw-bold mb-0 text-success">@ViewBag.TotalParticipants</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Role Status</h6>
                    <h2 class="fw-bold mb-0 text-info">Organiser</h2>
                </div>
            </div>
        </div>
    </div>
</div>