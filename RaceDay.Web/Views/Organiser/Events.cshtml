@{
    ViewData["Title"] = "Manage Races & Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Manage Races & Events</h2>
            <p class="text-muted">View, schedule, and review all active race events.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-primary px-4 py-2 fw-semibold">
            + Create New Event
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Status</th>
                        <th style="width: 220px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="eventsTableBody">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Loading events...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rawJson = '@Html.Raw(ViewBag.EventsJson ?? "[]")';
        const tbody = document.getElementById("eventsTableBody");

        try {
            const events = JSON.parse(rawJson);
            if (!events || events.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No events created yet. Click "Create New Event" above to get started.</td></tr>';
                return;
            }

            let rows = "";
            events.forEach(item => {
                const id = item.id || item.eventId || 0;
                const name = item.name || item.title || "Unnamed Event";
                const dateRaw = item.date || item.eventDate;
                const dateFormatted = dateRaw ? new Date(dateRaw).toLocaleDateString() : "TBD";
                const location = item.location || item.venue || "TBD";
                const distance = item.distance || "Standard";

                rows += `
                    <tr>
                        <td class="fw-bold text-muted">#${id}</td>
                        <td class="fw-semibold text-primary">${name}</td>
                        <td>${dateFormatted}</td>
                        <td>${location}</td>
                        <td><span class="badge bg-info text-dark">${distance}</span></td>
                        <td><span class="badge bg-success">Active</span></td>
                        <td class="text-end">
                            <a href="/Organiser/Categories?eventId=${id}" class="btn btn-sm btn-outline-primary me-1">Categories</a>
                            <a href="/Organiser/Results?eventId=${id}" class="btn btn-sm btn-outline-secondary">Results</a>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = rows;
        } catch (e) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Failed to load events data.</td></tr>';
        }
    });
</script>