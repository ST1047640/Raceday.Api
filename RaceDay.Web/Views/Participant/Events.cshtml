@model IEnumerable<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Races";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <span class="badge bg-success px-3 py-2 text-uppercase mb-2">Participant Portal</span>
        <h1 class="fw-bold">Explore Upcoming Races</h1>
        <p class="text-muted">Find your next challenge, register in your distance category, and track your official times.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@item.BannerUrl" class="card-img-top" alt="@item.EventName" style="height: 190px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border">@item.EventType</span>
                                <small class="text-muted"><i class="bi bi-geo-alt"></i> @item.City</small>
                            </div>
                            <h5 class="card-title fw-bold text-dark mb-2">@item.EventName</h5>
                            <p class="text-muted small mb-3">@item.Description</p>
                            <div class="mt-auto pt-3 border-top">
                                <a asp-controller="Participant" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-primary w-100 py-2 fw-semibold">
                                    View Details &amp; Register &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No upcoming races found.</p>
            </div>
        }
    </div>
</div>