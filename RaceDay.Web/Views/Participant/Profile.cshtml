@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 1.8rem; font-weight: bold;">
                        @(ViewBag.UserName != null ? ViewBag.UserName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <h4 class="fw-bold mb-1">@ViewBag.UserName</h4>
                    <span class="badge bg-success mb-4">@ViewBag.UserRole</span>

                    <div class="text-start border-top pt-3">
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Email Address</label>
                            <p class="fw-semibold mb-0">@ViewBag.UserEmail</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Account Status</label>
                            <p class="text-success fw-semibold mb-0">Active &amp; Verified</p>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <a asp-controller="Participant" asp-action="Events" class="btn btn-outline-primary">
                            Back to Races
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
